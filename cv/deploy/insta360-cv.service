[Unit]
Description=Insta360 Sign CV Demo API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ecs-user
Group=ecs-user
WorkingDirectory=/opt/insta360-cv
EnvironmentFile=/opt/insta360-cv/.env
ExecStart=/opt/insta360-cv/.venv/bin/python server.py --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
